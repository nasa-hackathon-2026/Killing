      "harmony_collection": "C2723754851-GES_DISC",
      "product": "GPM_3IMERGM.07",
      "source_long_name": "Merged satellite-gauge precipitation estimate - Final Run (recommended for general use)",
      "unit": "mm/hr",
      "valid_from": "1998-01-01",
      "valid_to": "2025-09-01"
    },
